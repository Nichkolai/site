{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.py": {
      "maxDuration": 30
    },
    "api/purchases.py": {
      "maxDuration": 30
    },
    "api/topup.py": {
      "maxDuration": 30
    },
    "api/game.py": {
      "maxDuration": 30
    }
  },
  "buildCommand": "python3 tools/stamp_assets.py",
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
