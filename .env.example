# KAZ bot configuration — copy to .env and fill in.
# Do not commit .env to Git.

BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://your-project.vercel.app
PORT=8080
HOST=0.0.0.0
SHUZA_API_BASE=https://api.shuzagram.com

# Used by the Vercel webhook (api/telegram.py) to authenticate Telegram requests.
# Generate a random value; keep it secret. Not needed for local long polling.
WEBHOOK_SECRET=

# Telegram numeric IDs of admins who receive withdrawal requests.
# Get your ID with /id in the bot. Multiple IDs: comma-separated.
# ADMIN_ID is also supported for a single admin.
ADMIN_IDS=
